{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun ci)",
      "Bash(bun install)",
      "Bash(bun run build)",
      "Bash(bun run lint)",
      "Bash(bun run fmt)",
      "Bash(bun run fmt:check)",
      "Bash(bun run test)",
      "Bash(bun run test *)",
      "Bash(bun run typecheck)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch origin main)",
      "Bash(git rebase origin/main)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Read(**/.env.example)"
    ],
    "deny": ["Read(**/.env)", "Read(**/.env.local)", "Read(**/.env.*.local)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/setup-workspace.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/setup-workspace.sh",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/turn-checks.sh snapshot",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/turn-checks.sh check",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "writing@josefaidt-skills": true,
    "typescript@josefaidt-skills": true,
    "design@josefaidt-skills": true,
    "agents@josefaidt-skills": true
  },
  "extraKnownMarketplaces": {
    "josefaidt-skills": {
      "source": {
        "source": "github",
        "repo": "josefaidt/skills"
      }
    }
  }
}
