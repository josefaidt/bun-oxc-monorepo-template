#!/bin/sh

# A rebase can bring in a dependency change, and the SessionStart hook that installs
# dependencies runs once when a session starts, so it never sees one. Install again
# when the rebase changed the lockfile or a package.json.

[ "$1" = "rebase" ] || exit 0
[ -n "$CI" ] && exit 0

git diff --name-only ORIG_HEAD HEAD | grep -qE '(^|/)(bun\.lock|package\.json)$' || exit 0

echo "post-rewrite: the rebase changed a dependency file, running 'bun ci'."
bun ci
