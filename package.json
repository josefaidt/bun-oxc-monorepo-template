{
  "name": "bun-oxc-monorepo-template",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@commitlint/cli": "^21.2.3",
      "@commitlint/config-conventional": "^21.2.3",
      "@types/bun": "^1.4.2",
      "@types/node": "^26.6.4",
      "oxfmt": "^0.76.0",
      "oxlint": "1.92.0",
      "oxlint-tsgolint": "^7.0.2003",
      "rolldown": "^1.2.12",
      "typescript": "^7.0.2",
      "vitest": "^4.1.10",
      "zod": "^4.6.5"
    }
  },
  "type": "module",
  "scripts": {
    "setup": "./scripts/setup.sh",
    "prepare": "git config core.hooksPath .git-hooks",
    "build": "bun run --filter './packages/*' --if-present build",
    "test": "bun run --filter '*' --if-present test",
    "typecheck": "bun run --filter '*' --if-present typecheck",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/bun": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.3"
}
