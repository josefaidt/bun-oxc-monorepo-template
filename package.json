{
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": ["apps/*", "packages/*"],
    "catalog": {
      "@types/bun": "latest",
      "@types/node": "latest",
      "oxfmt": "^0.41.0",
      "oxlint": "^1.56.0",
      "rolldown": "^1.0.0",
      "typescript": "^6.0.0"
    }
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
